<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[SYR] Processor Framework</li>
    </mods>
      <match Class="PatchOperationSequence">
      <operations>
		<!--
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName = "BMT_MushroomFermentingBarrel"]/designationCategory</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/WorkGiverDef[defName = "BMT_TakeMushroomWineOutOfFermentingBarrel" or defName = "BMT_FillMushroomFermentingBarrel"]</xpath>
        </li>
		-->
        <li Class="PatchOperationAdd">
		  <xpath>Defs</xpath>
          <value>
            <ProcessorFramework.ProcessDef>
				<defName>CYB_MushroomWineProcess</defName>
				<thingDef>BMT_MushroomWine</thingDef>
				<ingredientFilter>
				  <thingDefs>
					<li>BMT_MushroomMust</li>
				  </thingDefs>
				</ingredientFilter>
				<processDays>6</processDays> <!-- in days, a day is 60,000 ticks -->
				<usesTemperature>true</usesTemperature>
				<temperatureSafe>-1.0~32.0</temperatureSafe>
				<temperatureIdeal>7.0~32.0</temperatureIdeal>
				<ruinedPerDegreePerHour>2.5</ruinedPerDegreePerHour> <!-- percent per degree per hour -->
				<speedBelowSafe>0.1</speedBelowSafe>
				<speedAboveSafe>1.0</speedAboveSafe>
				<usesQuality>false</usesQuality>				
			</ProcessorFramework.ProcessDef>
          </value>
        </li>
		<li Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="BarrelProcessor"]/comps/
				li[@Class="ProcessorFramework.CompProperties_Processor"]/processes</xpath>
			<value>
				<li>CYB_MushroomWineProcess</li>
			</value>
		</li>
      </operations>
      </match>
  </Operation>

</Patch>