<?xml version="1.0" encoding="utf-8" ?>
<Patch>


<Operation Class="PatchOperationFindMod">
    <mods>
      <li>Medieval Overhaul</li>
    </mods>
	<match Class="PatchOperationSequence">
	<operations>
		<li Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[
					defName="DankPyon_LargeShelf_Wine" or
					defName="DankPyon_RusticCupboardWine"
				]/building/
				fixedStorageSettings/filter/thingDefs</xpath>
			<value>
				<li>BMT_MushroomWine</li>
			</value>
		</li>
		<li Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[
					defName="DankPyon_LargeShelf_Wine" or
					defName="DankPyon_RusticCupboardWine"
				]/building/
				defaultStorageSettings/filter/thingDefs</xpath>
			<value>
				<li>BMT_MushroomWine</li>
			</value>
		</li>
	</operations>
	</match>
</Operation>

</Patch>